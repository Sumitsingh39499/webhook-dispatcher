# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
# Host port 5433 (not 5432): a native PostgreSQL 15 service already occupies
# 5432 on this machine. Hosts pinned to 127.0.0.1 to avoid "localhost" resolving
# to IPv6 ::1, where a WSL relay listens on 6379.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=webhook_dispatcher
PG_USER=webhook_app
PG_PASSWORD=webhook_dev_password
# Render free tier: use the full connection string instead
# PG_CONNECTION_STRING=postgresql://user:pass@host:5432/dbname

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Render free tier: use the full connection URL instead
# REDIS_URL=rediss://user:pass@host:6379

# --- App behavior ---
# Comma-separated lowercase hostnames allowed to bypass SSRF protections in development
DEV_ALLOWED_LOCAL_HOSTS=localhost,127.0.0.1
